# 复制为 .env 后只在本地使用。不要把真实的 .env 提交进仓库。
# 下面的演示密码只用于本机原型，不是生产密钥。

DATABASE_URL=postgresql+asyncpg://skytrace:skytrace@localhost:5432/skytrace
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-local-env

# 媒体文件落在仓库下的 var/media，storage_key 是相对该目录的路径。
MEDIA_ROOT=var/media
MEDIA_PREVIEW_BASE_URL=/media
MEDIA_MAX_BYTES=10485760

# 会话 Cookie。本地 http 请保持 SESSION_COOKIE_SECURE=false。
SESSION_COOKIE_NAME=skytrace_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_LIFETIME_SECONDS=1209600

# 预置帐号。没有注册入口。种子脚本会按这些值创建或更新密码。
DEMO_AUTHOR_EMAIL=author@skytrace.local
DEMO_AUTHOR_PASSWORD=author-demo-pass
DEMO_AUTHOR_NAME=演示作者
DEMO_REVIEWER_EMAIL=reviewer@skytrace.local
DEMO_REVIEWER_PASSWORD=reviewer-demo-pass
DEMO_REVIEWER_NAME=演示审核员
